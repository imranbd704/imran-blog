export default function App() { return ( <div className="min-h-screen bg-slate-50 text-slate-900"> {/* Header */} <header className="bg-slate-900 text-white p-6"> <div className="max-w-5xl mx-auto"> <h1 className="text-3xl font-bold">Md. Imran Khan</h1> <p className="text-slate-300 mt-1">Educational Blog for Students & Job Seekers</p> </div> </header>

{/* Navigation */}
  <nav className="bg-white shadow-sm sticky top-0 z-10">
    <div className="max-w-5xl mx-auto flex gap-4 p-3 text-sm font-medium overflow-x-auto">
      <a href="#home" className="hover:text-blue-600">Home</a>
      <a href="#about" className="hover:text-blue-600">About</a>
      <a href="#posts" className="hover:text-blue-600">Blog</a>
      <a href="#tips" className="hover:text-blue-600">Study Tips</a>
      <a href="#contact" className="hover:text-blue-600">Contact</a>
    </div>
  </nav>

  {/* Hero */}
  <section id="home" className="max-w-5xl mx-auto p-6">
    <div className="bg-white rounded-2xl shadow p-6">
      <h2 className="text-2xl font-bold">Welcome to My Educational Blog</h2>
      <p className="mt-2 text-slate-600">
        I share study strategies, job preparation guides, and learning resources to help students grow.
      </p>
    </div>
  </section>

  {/* About */}
  <section id="about" className="max-w-5xl mx-auto p-6">
    <div className="bg-white rounded-2xl shadow p-6">
      <h2 className="text-xl font-semibold">About Me</h2>
      <p className="mt-2 text-slate-600">
        I am Md. Imran Khan. This blog is created to help students improve their study habits,
        English skills, and job preparation journey.
      </p>
    </div>
  </section>

  {/* Blog Posts */}
  <section id="posts" className="max-w-5xl mx-auto p-6">
    <h2 className="text-xl font-semibold mb-4">Latest Blog Posts</h2>
    <div className="grid gap-4 md:grid-cols-2">
      <div className="bg-white p-5 rounded-xl shadow">
        <h3 className="font-semibold">Daily Study Routine That Works</h3>
        <p className="text-sm text-slate-600 mt-1">Learn how to manage time effectively for exams.</p>
      </div>
      <div className="bg-white p-5 rounded-xl shadow">
        <h3 className="font-semibold">English Improvement Tips</h3>
        <p className="text-sm text-slate-600 mt-1">Simple methods to improve speaking and writing.</p>
      </div>
      <div className="bg-white p-5 rounded-xl shadow">
        <h3 className="font-semibold">Job Preparation Strategy</h3>
        <p className="text-sm text-slate-600 mt-1">How to prepare for competitive exams step by step.</p>
      </div>
      <div className="bg-white p-5 rounded-xl shadow">
        <h3 className="font-semibold">Time Management for Students</h3>
        <p className="text-sm text-slate-600 mt-1">Balance study and rest effectively.</p>
      </div>
    </div>
  </section>

  {/* Study Tips */}
  <section id="tips" className="max-w-5xl mx-auto p-6">
    <div className="bg-white rounded-2xl shadow p-6">
      <h2 className="text-xl font-semibold">Study Tips</h2>
      <ul className="list-disc pl-6 mt-2 text-slate-600 space-y-1">
        <li>Study daily with a fixed routine</li>
        <li>Take short breaks between study sessions</li>
        <li>Practice previous exam questions</li>
        <li>Focus on understanding, not memorizing</li>
      </ul>
    </div>
  </section>

  {/* Contact */}
  <section id="contact" className="max-w-5xl mx-auto p-6 pb-10">
    <div className="bg-white rounded-2xl shadow p-6">
      <h2 className="text-xl font-semibold">Contact</h2>
      <p className="text-slate-600 mt-2">Email: yourmail@example.com</p>
      <p className="text-slate-500 text-sm mt-1">Feel free to contact for collaboration or questions.</p>
    </div>
  </section>
</div>

); }
